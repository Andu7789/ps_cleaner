# --- Supabase (Dashboard > Project Settings > API) ---
# Shared Supabase project used by multiple apps in this workspace — every
# table this app owns is prefixed PS_CLEAN_ so it stays cleanly separable
# when this business gets its own dedicated project later. See DECISIONS.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Dashboard > Developers > API keys) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=bookings@example.com

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Scheduled jobs (day-before reminders, balance charges) ---
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
